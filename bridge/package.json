{
  "name": "@agentic-wear/bridge",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "bin": {
    "agentic-wear": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && oxlint --deny typescript/no-floating-promises src test",
    "dev": "tsx src/cli.ts",
    "test": "vitest run && node --test test/browser-cloud-content.test.mjs test/native-dot-browser.test.mjs test/browser-worker.test.mjs test/browser-cloud-working.test.mjs",
    "build:desktop-cloud": "node scripts/bundle-desktop-cloud.mjs",
    "bundle:native-host": "node scripts/bundle-native-host.mjs"
  },
  "dependencies": {
    "openai": "7.8.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
