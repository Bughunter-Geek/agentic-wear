{
  "name": "@agentic-wear/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentic-wear": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
