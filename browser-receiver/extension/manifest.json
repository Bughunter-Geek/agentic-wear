{
  "manifest_version": 3,
  "name": "Agentic Wear Cloud Receiver",
  "version": "0.3.16",
  "description": "Cloud text and configured Dot voice using your own signed-in browser and local companion.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Agentic Wear Cloud Receiver",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/local/*",
        "https://chatgpt.com/dots/home"
      ],
      "js": [
        "remote-peer.js",
        "voice-timing.js",
        "native-allocation.js",
        "voice-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/local/*",
        "https://chatgpt.com/dots/home"
      ],
      "js": [
        "voice-controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/local/*",
    "https://chatgpt.com/dots/home"
  ]
}
