{
  "manifest_version": 3,
  "name": "Agentic Wear Cloud Receiver",
  "version": "0.3.11",
  "description": "Text, history and native Watch voice for Lumen using your signed-in browser.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Agentic Wear Cloud Receiver"
  },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/dots/home"], "js": ["remote-peer.js", "voice-timing.js", "native-allocation.js", "voice-hook.js"], "world": "MAIN", "run_at": "document_start" },
    {
      "matches": [
        "https://chatgpt.com/local/*",
        "https://chatgpt.com/dots/home"
      ],
      "js": [
        "voice-controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/local/*",
    "https://chatgpt.com/dots/home"
  ]
}
