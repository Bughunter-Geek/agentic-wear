{
  "manifest_version": 3,
  "name": "Agentic Wear Cloud Receiver",
  "version": "0.2.0",
  "description": "Text replies and message history for your selected cloud chat and Lumen.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Agentic Wear Cloud Receiver"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/local/01a1188b-a850-755b-91ec-717f6182900a*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/dots/home"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
