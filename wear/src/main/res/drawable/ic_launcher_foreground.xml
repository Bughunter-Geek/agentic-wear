<?xml version="1.0" encoding="utf-8"?>
<!-- Agentic Wear: the live-voice cloud orb floating on black. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft halo -->
    <path android:pathData="M54,18a36,36 0,1 0,0.01 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="56"
                android:gradientRadius="36">
                <item android:offset="0" android:color="#5500B7A0" />
                <item android:offset="0.55" android:color="#2200B7A0" />
                <item android:offset="1" android:color="#0000B7A0" />
            </gradient>
        </aapt:attr>
    </path>

    <group>
        <clip-path android:pathData="M54,29a25,25 0,1 0,0.01 0z" />

        <!-- Base: deep teal at the bottom to pale mint at the top -->
        <path android:pathData="M54,29a25,25 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="83.5"
                    android:gradientRadius="56">
                    <item android:offset="0" android:color="#FF006E5E" />
                    <item android:offset="0.46" android:color="#FF00B7A0" />
                    <item android:offset="1" android:color="#FFE6FFFB" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fog: deep current, lower right -->
        <path android:pathData="M62.5,40a23,23 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="62.5"
                    android:centerY="63"
                    android:gradientRadius="23">
                    <item android:offset="0" android:color="#F0006E5E" />
                    <item android:offset="1" android:color="#00006E5E" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fog: cool accent, upper right -->
        <path android:pathData="M61,30a16,16 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="61"
                    android:centerY="46"
                    android:gradientRadius="16">
                    <item android:offset="0" android:color="#E673CFFF" />
                    <item android:offset="1" android:color="#0073CFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fog: base, lower left -->
        <path android:pathData="M45,46a18,18 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="45"
                    android:centerY="64"
                    android:gradientRadius="18">
                    <item android:offset="0" android:color="#FF00B7A0" />
                    <item android:offset="1" android:color="#0000B7A0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Fog: bright cloud, upper left -->
        <path android:pathData="M45,23a19.5,19.5 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="45"
                    android:centerY="42.5"
                    android:gradientRadius="19.5">
                    <item android:offset="0" android:color="#EBFFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Gloss -->
        <path android:pathData="M45,24a18,18 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="45"
                    android:centerY="41"
                    android:gradientRadius="18">
                    <item android:offset="0" android:color="#80FFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Edge depth -->
        <path android:pathData="M54,29a25,25 0,1 0,0.01 0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="54"
                    android:gradientRadius="25">
                    <item android:offset="0" android:color="#00000000" />
                    <item android:offset="0.62" android:color="#00000000" />
                    <item android:offset="1" android:color="#2E000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
