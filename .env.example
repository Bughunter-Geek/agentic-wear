# Used only by the local macOS bridge. Copy to .env.local; never commit real values.
AGENTIC_WEAR_RELAY_URL=https://agentic-wear-relay.example.workers.dev
AGENTIC_WEAR_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
# Free, private default: multilingual Whisper runs on the Apple-silicon bridge host.
AGENTIC_WEAR_TRANSCRIPTION_PROVIDER=local
AGENTIC_WEAR_WHISPER_MODEL=mlx-community/whisper-turbo
# Optional paid fallback only. Uncomment both lines to use OpenAI's hosted API.
# AGENTIC_WEAR_TRANSCRIPTION_PROVIDER=openai
# OPENAI_API_KEY=your-dedicated-openai-api-key
AGENTIC_WEAR_TRANSCRIPTION_MODEL=gpt-transcribe
