# Copy to .dev.vars for local development. Never commit real values.
PAIRING_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
PAIRING_CREDENTIAL_SECRET=replace-with-a-different-32-character-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n
